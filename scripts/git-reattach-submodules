#!/usr/bin/env bash
#
# Syncs every submodule of the current repo to the commit pinned by
# whatever branch is currently checked out (git submodule update --init),
# then reattaches each one's detached HEAD to the branch declared for it
# in .gitmodules — at that same commit. Never fetches, and never moves a
# submodule past the commit its parent branch already pins.
#
# Submodules with no branch declared, or with uncommitted changes, are
# skipped for the reattach step (the sync step still applies to them).
#
# Usage (run from anywhere inside the repo, after switching branches):
#   git reattach-submodules [--dry-run]

set -euo pipefail

BOLD_YELLOW="\e[1;33m"
BOLD_GREEN="\e[1;32m"
BOLD_CYAN="\e[1;36m"
DIM="\e[2;37m"
RESET="\e[0m"

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

repo=$(git rev-parse --show-toplevel)
gitmodules="$repo/.gitmodules"

if [ ! -f "$gitmodules" ]; then
  echo -e "${BOLD_YELLOW}No .gitmodules in $repo — nothing to do.${RESET}"
  exit 0
fi

current_branch=$(git -C "$repo" symbolic-ref --short -q HEAD || echo "(detached)")
echo -e "${BOLD_CYAN}Repo: $repo (branch: $current_branch)${RESET}"
[ "$DRY_RUN" -eq 1 ] && echo -e "${BOLD_YELLOW}(dry run — no changes will be made)${RESET}"
echo

if [ "$DRY_RUN" -eq 1 ]; then
  echo -e "${BOLD_YELLOW}(dry run — skipping submodule sync, results below may be stale)${RESET}"
else
  echo -e "${BOLD_CYAN}Syncing submodules to '$current_branch' pinned commits...${RESET}"
  git -C "$repo" submodule update --init
fi
echo

names=$(git config -f "$gitmodules" --get-regexp '^submodule\..*\.path$' \
          | sed -E 's/^submodule\.(.*)\.path .*/\1/')

for name in $names; do
  path=$(git config -f "$gitmodules" --get "submodule.$name.path")
  branch=$(git config -f "$gitmodules" --get "submodule.$name.branch" 2>/dev/null || true)
  submodule_dir="$repo/$path"

  if [ ! -e "$submodule_dir/.git" ]; then
    echo -e "  - $path: ${BOLD_YELLOW}not initialized, skipping${RESET}"
    continue
  fi

  if [ -z "$branch" ]; then
    echo -e "  - $path: ${BOLD_YELLOW}no branch declared in .gitmodules, skipping${RESET}"
    continue
  fi

  if ! git -C "$submodule_dir" diff --quiet --ignore-submodules 2>/dev/null \
     || ! git -C "$submodule_dir" diff --cached --quiet --ignore-submodules 2>/dev/null; then
    echo -e "  - $path: ${BOLD_YELLOW}has uncommitted changes, skipping${RESET}"
    continue
  fi

  if git -C "$submodule_dir" symbolic-ref -q HEAD > /dev/null; then
    current_branch=$(git -C "$submodule_dir" symbolic-ref --short HEAD)
    echo -e "  - $path: ${DIM}already on branch '$current_branch', skipping${RESET}"
    continue
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    echo -e "  - $path: ${BOLD_GREEN}detached -> would attach to '$branch'${RESET}"
  else
    git -C "$submodule_dir" checkout -B "$branch" HEAD > /dev/null
    echo -e "  - $path: ${BOLD_GREEN}detached -> attached to '$branch'${RESET}"
  fi
done
